{
  "type": "object",
  "required": ["feature", "phase_number", "phase", "progress", "status", "updated_at", "next_action", "events", "requirement_coverage", "verification_head"],
  "properties": {
    "feature": {"type": "string"},
    "phase_number": {"type": "integer", "minimum": 1, "maximum": 8},
    "phase": {"enum": ["Orient", "Design debate", "Design approved", "Implementation", "Independent review", "Checks & documentation", "Awaiting deployment approval", "Live verified"]},
    "progress": {"type": "number", "minimum": 0, "maximum": 100},
    "status": {"enum": ["in_progress", "blocked", "ready_to_deploy", "awaiting_approval", "complete"]},
    "updated_at": {"type": "string", "format": "date-time"},
    "next_action": {"type": "string"},
    "design_round": {"type": "integer", "minimum": 0},
    "review_round": {"type": "integer", "minimum": 0},
    "legacy_review_round_offset": {"type": "integer", "minimum": 0},
    "review_attempts": {
      "type": "array", "maxItems": 64,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["attempt_id", "attempt", "opened_at", "closed_at", "opened_by", "reviewer", "session_ids", "trigger", "trigger_detail", "acceptance_hash", "phase_number", "disposition", "findings"],
        "properties": {
          "attempt_id": {"type": "string", "pattern": "^ha-[0-9a-f]{32}$"},
          "attempt": {"type": "integer", "minimum": 1},
          "opened_at": {"type": "string", "format": "date-time"},
          "closed_at": {"type": ["string", "null"], "format": "date-time"},
          "opened_by": {"type": "string", "minLength": 1, "maxLength": 128},
          "reviewer": {"type": ["string", "null"], "maxLength": 128},
          "session_ids": {"type": "array", "maxItems": 160, "uniqueItems": true, "items": {"type": "string", "pattern": "^hs-[0-9a-f]{32}$"}},
          "trigger": {"enum": ["initial", "changes_requested", "acceptance_changed", "implementation_changed", "supervisor_remediation", "manual_override"]},
          "trigger_detail": {"type": "string", "maxLength": 512},
          "acceptance_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "phase_number": {"type": "integer", "minimum": 1, "maximum": 8},
          "disposition": {"enum": ["open", "approved", "changes_requested", "abandoned", "unrecorded"]},
          "findings": {"type": "array", "maxItems": 16, "items": {"type": "object", "additionalProperties": false, "required": ["code", "summary"], "properties": {"code": {"enum": ["acceptance_not_met", "incorrect_implementation", "review_changes_requested", "other"]}, "summary": {"type": "string", "minLength": 1, "maxLength": 512}}}}
        }
      }
    },
    "review_cap_overrides": {"type": "array", "maxItems": 8},
    "escalation": {
      "type": ["object", "null"], "additionalProperties": false,
      "required": ["kind", "at", "reason", "required_action", "source"],
      "properties": {
        "kind": {"enum": ["review_cap_exhausted", "recovery_exhausted", "recovery_paused"]},
        "at": {"type": "string", "format": "date-time"},
        "reason": {"type": "string", "minLength": 1},
        "required_action": {"type": "string", "minLength": 1},
        "source": {"type": "string", "minLength": 1}
      }
    },
    "recovery_attempts": {
      "type": "array", "maxItems": 16,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["recovery_id", "role", "trigger", "from_session_id", "to_session_id", "attempt", "cap", "holder", "state", "reason", "at", "launched_at", "ended_at"],
        "properties": {
          "recovery_id": {"type": "string", "pattern": "^hv-[0-9a-f]{32}$"},
          "role": {"enum": ["architect", "supervisor", "implementer", "reviewer"]},
          "trigger": {"enum": ["worker_terminal", "worker_silent", "silent_run"]},
          "from_session_id": {"type": ["string", "null"]},
          "to_session_id": {"type": ["string", "null"]},
          "attempt": {"type": "integer", "minimum": 1},
          "cap": {"type": "integer", "minimum": 0, "maximum": 16},
          "holder": {"type": "string", "minLength": 1},
          "state": {"enum": ["reserved", "launched", "recovered", "failed", "escalated"]},
          "reason": {"type": "string", "minLength": 1},
          "at": {"type": "string", "format": "date-time"},
          "launched_at": {"type": ["string", "null"], "format": "date-time"},
          "ended_at": {"type": ["string", "null"], "format": "date-time"}
        }
      }
    },
    "recovery_lease": {
      "type": ["object", "null"], "additionalProperties": false,
      "required": ["lease_id", "holder", "acquired_at", "expires_at", "recovery_id"],
      "properties": {
        "lease_id": {"type": "string", "pattern": "^hl-[0-9a-f]{32}$"},
        "holder": {"type": "string", "minLength": 1},
        "acquired_at": {"type": "string", "format": "date-time"},
        "expires_at": {"type": "string", "format": "date-time"},
        "recovery_id": {"type": "string", "pattern": "^hv-[0-9a-f]{32}$"}
      }
    },
    "regression_requests": {
      "type": "array", "maxItems": 16,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["request_id", "group", "commands", "command_sha256", "state", "requested_by", "requested_at", "expires_at", "decided_by", "decided_at", "launched_at", "completed_at", "launch_nonce_sha256", "repository", "acceptance_hash", "config_hash", "results"],
        "properties": {
          "request_id": {"type": "string", "pattern": "^rg-[0-9a-f]{32}$"},
          "group": {"type": "string", "minLength": 1, "maxLength": 64},
          "commands": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "command_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "state": {"enum": ["awaiting_approval", "accepted", "declined", "expired", "invalidated", "launched", "completed", "failed", "cancelled"]},
          "requested_by": {"type": "string", "minLength": 1},
          "requested_at": {"type": "string", "format": "date-time"},
          "expires_at": {"type": "string", "format": "date-time"},
          "decided_by": {"type": ["string", "null"]},
          "decided_at": {"type": ["string", "null"], "format": "date-time"},
          "launched_at": {"type": ["string", "null"], "format": "date-time"},
          "completed_at": {"type": ["string", "null"], "format": "date-time"},
          "launch_nonce_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
          "repository": {"type": "object"},
          "acceptance_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "config_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "results": {"type": "array"}
        }
      }
    },
    "retry_count": {"type": "integer", "minimum": 0},
    "implemented_by": {"type": ["string", "null"]},
    "reviewed_by": {"type": ["string", "null"]},
    "original_symptom_evidence_id": {"type": ["string", "null"]},
    "live_verification_id": {"type": ["string", "null"]},
    "verification_head": {"type": "string"},
    "requires_design_review": {"type": "boolean"},
    "agent_sessions": {
      "type": "object",
      "maxProperties": 64,
      "patternProperties": {
        "^hs-[0-9a-f]{32}$": {
          "type": "object",
          "additionalProperties": false,
          "required": ["session_id", "role", "actor", "adapter", "requested_model", "reported_model", "resolution_source", "started_at", "running_at", "ended_at", "state", "exit_code"],
          "properties": {
            "session_id": {"type": "string", "pattern": "^hs-[0-9a-f]{32}$", "maxLength": 64},
            "role": {"enum": ["architect", "supervisor", "implementer", "reviewer"]},
            "actor": {"type": "string", "minLength": 1, "maxLength": 128},
            "adapter": {"enum": ["codex", "claude"]},
            "requested_model": {"type": "string", "minLength": 1, "maxLength": 128},
            "reported_model": {"type": ["string", "null"], "maxLength": 128},
            "resolution_source": {"enum": ["configured", "auto_detected", "legacy_auto_detected", "fallback"]},
            "started_at": {"type": "string", "format": "date-time"},
            "running_at": {"type": ["string", "null"], "format": "date-time"},
            "ended_at": {"type": ["string", "null"], "format": "date-time"},
            "state": {"enum": ["launching", "running", "completed", "failed", "timed_out", "cancelled", "failed_to_start"]},
            "exit_code": {"type": ["integer", "null"]}
          }
        }
      },
      "additionalProperties": false
    },
    "current_agent_sessions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "architect": {"type": "string", "pattern": "^hs-[0-9a-f]{32}$"},
        "supervisor": {"type": "string", "pattern": "^hs-[0-9a-f]{32}$"},
        "implementer": {"type": "string", "pattern": "^hs-[0-9a-f]{32}$"},
        "reviewer": {"type": "string", "pattern": "^hs-[0-9a-f]{32}$"}
      }
    },
    "agent_failures": {
      "type": "object",
      "maxProperties": 64,
      "patternProperties": {
        "^hs-[0-9a-f]{32}$": {
          "type": "object",
          "additionalProperties": false,
          "required": ["session_id", "category", "reason", "tail_sha256", "at"],
          "properties": {
            "session_id": {"type": "string", "pattern": "^hs-[0-9a-f]{32}$"},
            "category": {"enum": ["cancelled", "timeout", "auth_failure", "rate_limit", "context_exhaustion", "process_crash", "non_zero_exit", "unknown", "presumed_lost"]},
            "reason": {"type": "string"},
            "tail_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "at": {"type": "string", "format": "date-time"}
          }
        }
      },
      "additionalProperties": false
    },
    "agent_quality_findings": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["finding_id", "session_id", "role", "code", "count", "limit", "review_round", "distinct_round_count", "eligible", "at"],
        "properties": {
          "finding_id": {"type": "string", "pattern": "^hq-[0-9a-f]{32}$"},
          "session_id": {"type": "string", "pattern": "^hs-[0-9a-f]{32}$"},
          "role": {"enum": ["architect", "supervisor", "implementer", "reviewer"]},
          "code": {"enum": ["acceptance_not_met", "incorrect_implementation", "review_changes_requested"]},
          "count": {"type": "integer", "minimum": 1},
          "limit": {"type": "integer", "minimum": 0},
          "review_round": {"type": "integer", "minimum": 0},
          "distinct_round_count": {"type": "integer", "minimum": 0},
          "eligible": {"type": "boolean"},
          "at": {"type": "string", "format": "date-time"}
        }
      }
    },
    "reviewer_implementer_bindings": {
      "type": "object",
      "maxProperties": 64,
      "patternProperties": {
        "^hs-[0-9a-f]{32}$": {
          "type": "object",
          "additionalProperties": false,
          "required": ["reviewer_session_id", "implementer_session_id", "adapter", "model", "bound_at"],
          "properties": {
            "reviewer_session_id": {"type": "string", "pattern": "^hs-[0-9a-f]{32}$"},
            "implementer_session_id": {"type": ["string", "null"], "pattern": "^hs-[0-9a-f]{32}$"},
            "adapter": {"enum": ["codex", "claude"]},
            "model": {"type": "string", "minLength": 1, "maxLength": 128},
            "bound_at": {"type": "string", "format": "date-time"}
          }
        }
      },
      "additionalProperties": false
    },
    "agent_replacements": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["replacement_id", "role", "from_session_id", "to_session_id", "trigger", "category", "reason", "attempt", "cap", "action", "planner_reason", "skipped", "selected_profile", "handoff", "state", "at"],
        "properties": {
          "replacement_id": {"type": "string", "pattern": "^hr-[0-9a-f]{32}$"},
          "role": {"enum": ["architect", "supervisor", "implementer", "reviewer"]},
          "from_session_id": {"type": "string", "pattern": "^hs-[0-9a-f]{32}$"},
          "to_session_id": {"type": ["string", "null"], "pattern": "^hs-[0-9a-f]{32}$"},
          "trigger": {"enum": ["runtime_failure", "quality_finding"]},
          "category": {"enum": ["cancelled", "timeout", "auth_failure", "rate_limit", "context_exhaustion", "process_crash", "non_zero_exit", "unknown", "still_running"]},
          "reason": {"type": "string"},
          "attempt": {"type": "integer", "minimum": 0, "maximum": 8},
          "cap": {"type": "integer", "minimum": 0, "maximum": 8},
          "action": {"enum": ["launch", "pilot_pause"]},
          "planner_reason": {"type": "string"},
          "skipped": {"type": "array", "maxItems": 8},
          "selected_profile": {"type": ["object", "null"]},
          "handoff": {"type": ["object", "null"]},
          "state": {"enum": ["reserved", "claimed", "running", "failed", "recovered", "pilot_pause"]},
          "claimed_at": {"type": "string", "format": "date-time"},
          "running_at": {"type": "string", "format": "date-time"},
          "ended_at": {"type": "string", "format": "date-time"},
          "at": {"type": "string", "format": "date-time"}
        }
      }
    },
    "design_review": {
      "type": ["object", "null"],
      "properties": {
        "by": {"type": "string"},
        "architect": {"type": "string"},
        "at": {"type": "string", "format": "date-time"},
        "decision": {"enum": ["approved", "changes_requested"]},
        "summary": {"type": "string"},
        "design_hash": {"type": "string"},
        "config_hash": {"type": "string"}
      }
    },
    "review": {
      "type": ["object", "null"],
      "properties": {
        "by": {"type": "string"}, "at": {"type": "string", "format": "date-time"},
        "acceptance_hash": {"type": "string"}, "checklist": {"type": "object"},
        "implementer_profile": {"type": "object"}, "reviewer_profile": {"type": "object"},
        "profiles_distinct": {"type": "boolean"}
      }
    },
    "deployment_approved": {
      "type": ["object", "null"],
      "properties": {"at": {"type": "string"}, "by": {"type": "string"}, "acceptance_hash": {"type": "string"}}
    },
    "requirement_coverage": {
      "type": "object",
      "required": ["passing", "failing", "not_tested", "blocked", "original_symptom_resolved"],
      "properties": {
        "passing": {"type": "integer"}, "failing": {"type": "integer"},
        "not_tested": {"type": "integer"}, "blocked": {"type": "integer"},
        "original_symptom_resolved": {"type": "boolean"}
      }
    },
    "events": {"type": "array"}
  }
}
