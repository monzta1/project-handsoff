{
  "type": "object",
  "required": [
    "feature",
    "criteria"
  ],
  "properties": {
    "feature": {
      "type": "string"
    },
    "criteria": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "type",
          "requirement",
          "verification",
          "tests",
          "evidence",
          "state"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "enum": [
              "primary_fix",
              "supporting"
            ]
          },
          "requirement": {
            "type": "string"
          },
          "verification": {
            "enum": [
              "automated",
              "manual",
              "browser",
              "automated_and_browser",
              "automated_and_mutation"
            ]
          },
          "tests": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^vr-[a-f0-9]{32}$"
            }
          },
          "state": {
            "enum": [
              "failing",
              "passing",
              "not_tested",
              "blocked"
            ]
          },
          "baseline": {
            "enum": [
              "not_applicable"
            ],
            "description": "#165: no failing run can exist for this criterion; baseline_reason says why"
          },
          "baseline_reason": {
            "type": "string",
            "minLength": 1
          },
          "repeat": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50,
            "description": "#169: the commands must pass this many times in a row"
          },
          "seed_env": {
            "type": "string",
            "pattern": "^[A-Z_][A-Z0-9_]{0,63}$"
          },
          "mutation_target": {
            "type": "string",
            "minLength": 1,
            "description": "#349: the project-relative file defining the function the tests must detect the loss of; set with mutation_symbol, required by automated_and_mutation"
          },
          "mutation_symbol": {
            "type": "string",
            "minLength": 1,
            "description": "#349: that function's name; set with mutation_target"
          },
          "outcome": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "description": "P1.1: the observable outcome the criterion states"
          },
          "evidence_classes": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "checks",
                "manual",
                "browser",
                "workflow"
              ]
            },
            "description": "P1.1: evidence kinds required on top of the verification policy; checks needs tests among [checks].commands; mutation is policy-only (automated_and_mutation)"
          },
          "paths": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "not": {
                "pattern": "(^[/\\\\])|(^|/)\\.\\.(/|$)"
              }
            },
            "description": "P1.2: project-relative globs the criterion's evidence depends on; its scoped digest covers the matching repository entries"
          },
          "risk": {
            "enum": [
              "normal",
              "elevated"
            ],
            "description": "P2.2: absent means normal; an elevated criterion needs every negative_paths dimension before Phase 3"
          },
          "negative_paths": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": false,
            "properties": {
              "unauthorized": {"type": "string", "minLength": 1, "maxLength": 512},
              "malformed_input": {"type": "string", "minLength": 1, "maxLength": 512},
              "duplicate": {"type": "string", "minLength": 1, "maxLength": 512},
              "timeout_retry": {"type": "string", "minLength": 1, "maxLength": 512},
              "stale_data": {"type": "string", "minLength": 1, "maxLength": 512},
              "partial_failure": {"type": "string", "minLength": 1, "maxLength": 512},
              "rollback": {"type": "string", "minLength": 1, "maxLength": 512}
            },
            "description": "P2.2: each dimension's test description, or 'not_applicable: REASON'"
          }
        }
      }
    },
    "work_items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "number",
          "title",
          "url",
          "required",
          "github_state",
          "github_checked_at",
          "created_at",
          "updated_at",
          "notes"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^(issue-[1-9][0-9]{0,8}|ask-[a-z0-9][a-z0-9-]{0,39}|unattributed)$"
          },
          "kind": {
            "enum": [
              "issue",
              "ask"
            ]
          },
          "number": {
            "type": [
              "integer",
              "null"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "url": {
            "type": "string"
          },
          "required": {
            "type": "boolean"
          },
          "github_state": {
            "enum": [
              "open",
              "closed",
              null
            ]
          },
          "github_checked_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          },
          "notes": {
            "type": "string",
            "maxLength": 512
          },
          "implemented_at": {
            "type": "string",
            "format": "date-time",
            "description": "#415: when a completed implementer session bound to this item (launch --item) landed"
          },
          "implemented_by": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "description": "#415: the actor of that bound session"
          }
        }
      }
    },
    "work_items_explicit": {
      "type": "boolean"
    },
    "repository": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 200
    },
    "removed_work_items": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "by",
          "at"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "by": {
            "type": "string",
            "minLength": 1
          },
          "at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  }
}
